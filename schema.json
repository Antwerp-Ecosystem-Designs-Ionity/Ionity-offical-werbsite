  "knowledge_graph_patterns": {
    "entity_hierarchy": {
      "organization": {
        "Ionity (Pty) Ltd": [
          "AEDI Automated Ecosystems",
          "Edge AI Platform",
          "Cloud Infrastructure"
        ]
      },
      "technology_stack": {
        "Hardware": ["Power-Saving Units", "Embedded Systems"],
        "Software": ["Edge AI", "Digital Twins", "Cloud Platform"],
        "Security": ["Zero-Trust Architecture", "Encryption"]
      }
    },

    "inference_rules": [
      {
        "if": [
          "Entity CREATED_BY Johan Wilhelm van Antwerp",
          "Entity MAINTAINED_BY Ionity"
        ],
        "then": "Entity is part of AEDI Ecosystem"
      },
      {
        "if": ["Technology PART_OF AEDI Ecosystem"],
        "then": ["Technology LICENSED_UNDER OR GOVERNED_BY Policy/License"]
      },
      {
        "if": ["Entity DEPLOYED AT Production"],
        "then": ["Entity REQUIRES Zero-Trust Security"]
      },
      {
        "if": ["Entity Handles User Data"],
        "then": ["Entity COMPLIES_WITH GDPR"]
      }
    ],

    "query_patterns": {
      "creator_works": "SELECT * WHERE CREATED_BY = 'johan_wilhelm_van_antwerp'",
      "ecosystem_components": "SELECT * WHERE PART_OF = 'aedi_ecosystem'",
      "security_requirements": "SELECT * WHERE SECURES = 'aedi_ecosystem'",
      "commercial_offerings": "SELECT * WHERE LICENSED_UNDER IN ['license_aed_900', 'license_aed_986']"
    }
  },

